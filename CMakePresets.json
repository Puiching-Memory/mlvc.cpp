{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MLVC_ENABLE_IPO": "ON",
        "MLVC_MODEL_ROOT": "${sourceDir}/models/canonical",
        "MLVC_TEST_ASSETS_DIR": "${sourceDir}/models/fixtures"
      }
    },
    {
      "name": "driver-cubin-release",
      "displayName": "Driver+cubin Release",
      "inherits": "release-base",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "driver-cubin-sanitize",
      "displayName": "Driver+cubin Host Sanitizers",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MLVC_EMBED_MODELS": "OFF",
        "MLVC_ENABLE_IPO": "OFF",
        "MLVC_ENABLE_SANITIZERS": "ON",
        "MLVC_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "driver-cubin-release",
      "configurePreset": "driver-cubin-release"
    },
    {
      "name": "driver-cubin-sanitize",
      "configurePreset": "driver-cubin-sanitize",
      "targets": [
        "mlvc_core_safety_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "driver-cubin-release",
      "configurePreset": "driver-cubin-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "driver-cubin-sanitize",
      "configurePreset": "driver-cubin-sanitize",
      "filter": {
        "include": {
          "name": "mlvc_core_safety"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

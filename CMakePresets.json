{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MLVC_ENABLE_IPO": "ON",
        "MLVC_MODEL_ROOT": "${sourceDir}/models/canonical",
        "MLVC_TEST_ASSETS_DIR": "${sourceDir}/models/fixtures"
      }
    },
    {
      "name": "driver-cubin-release",
      "displayName": "Driver+cubin Release",
      "inherits": "release-base",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "driver-cubin-sanitize",
      "displayName": "Driver+cubin Host Sanitizers",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MLVC_EMBED_MODELS": "OFF",
        "MLVC_ENABLE_IPO": "OFF",
        "MLVC_ENABLE_SANITIZERS": "ON",
        "MLVC_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "cpu-release",
      "displayName": "CPU Backend Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MLVC_BACKEND": "cpu",
        "MLVC_EMBED_MODELS": "OFF",
        "MLVC_ENABLE_IPO": "ON",
        "MLVC_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "cpu-sanitize",
      "displayName": "CPU Backend ASan+UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MLVC_BACKEND": "cpu",
        "MLVC_EMBED_MODELS": "OFF",
        "MLVC_ENABLE_IPO": "OFF",
        "MLVC_ENABLE_SANITIZERS": "ON",
        "MLVC_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "cpu-tsan",
      "displayName": "CPU Backend ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MLVC_BACKEND": "cpu",
        "MLVC_EMBED_MODELS": "OFF",
        "MLVC_ENABLE_IPO": "OFF",
        "MLVC_ENABLE_TSAN": "ON",
        "MLVC_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "driver-cubin-release",
      "configurePreset": "driver-cubin-release"
    },
    {
      "name": "driver-cubin-sanitize",
      "configurePreset": "driver-cubin-sanitize",
      "targets": [
        "mlvc_core_safety_tests",
        "mlvc_bitstream_tests",
        "mlvc_c_api_tests",
        "mlvc_public_header_tests",
        "mlvc_model_proto_tests",
        "mlvc_runtime_decoupling_tests"
      ]
    },
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release"
    },
    {
      "name": "cpu-sanitize",
      "configurePreset": "cpu-sanitize"
    },
    {
      "name": "cpu-tsan",
      "configurePreset": "cpu-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "driver-cubin-release",
      "configurePreset": "driver-cubin-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "driver-cubin-sanitize",
      "configurePreset": "driver-cubin-sanitize",
      "filter": {
        "exclude": {
          "label": "gpu"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-sanitize",
      "configurePreset": "cpu-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-tsan",
      "configurePreset": "cpu-tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
